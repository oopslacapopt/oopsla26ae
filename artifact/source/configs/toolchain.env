# CapOpt toolchain configuration (plan M0.2) — single source of truth for
# every build/measure script.  Source this file (or export the variables)
# before running benchmarks/scripts/*.py or scripts/run_all.sh.
#
# All build scripts honor these variables and fall back to the historical
# hardcoded developer paths only when they are unset.

# --- CHERI-RISC-V toolchain -------------------------------------------------
# Official pin (decision D5, see docs/paper-claims-audit-2026-07-24.md):
#   paper (Sec. 5.1) states CHERI-LLVM 17.0.0 @ 9e82d2969a6
#   committed motivation artifacts were built @ 0303e6f03ed4aede9d0659d294cdb4e692cadafc
# The dated re-run (plan M5) must be produced with ONE commit and the paper
# updated to match.  Record the chosen commit here:
export CHERI_LLVM_COMMIT="9e82d2969a6"
export CHERI_LLVM_BIN="${CHERI_LLVM_BIN:-$HOME/cheri/output/sdk/bin}"
export CHERI_SYSROOT="${CHERI_SYSROOT:-$HOME/cheri/output/rootfs-riscv64-purecap}"

# --- Morello toolchain --------------------------------------------------------
export MORELLO_LLVM_BIN="${MORELLO_LLVM_BIN:-$HOME/cheri/output/morello-sdk/bin}"
export MORELLO_SYSROOT="${MORELLO_SYSROOT:-$HOME/cheri/output/rootfs-morello-purecap}"

# --- Emulation / measurement --------------------------------------------------
export QEMU_CHERI_BIN="${QEMU_CHERI_BIN:-$HOME/cheri/output/sdk/bin/qemu-system-riscv64cheri}"
export QEMU_CHERI_IMAGE="${QEMU_CHERI_IMAGE:-$HOME/cheri/output/cheribsd-riscv64-purecap.img}"
# Two identical Morello boards (user-confirmed 2026-07-10); the runner
# round-robins across MORELLO_HOSTS.
export MORELLO_HOST="${MORELLO_HOST:-root@192.168.10.101}"
export MORELLO_HOST_FALLBACK="${MORELLO_HOST_FALLBACK:-root@192.168.10.102}"
export MORELLO_HOSTS="${MORELLO_HOSTS:-root@192.168.10.101 root@192.168.10.102}"

# --- Experiment protocol (plan M5) ---------------------------------------------
export CAPOPT_N_RUNS="${CAPOPT_N_RUNS:-10}"       # paper Sec. 5.1: ten runs, median
export CAPOPT_WARMUP="${CAPOPT_WARMUP:-1}"
